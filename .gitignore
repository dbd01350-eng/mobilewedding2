.env
.env.production
.env.development
.env.local
.env.*.local
*.pem
*.key
*.cert

# ==========================================
# 2. 의존성 및 패키지 매니저 (Dependencies & Lock)
# ==========================================
node_modules/
.npm/
.yarn/cache/
.yarn/unplugged/
.pnp.*

# ==========================================
# 3. 빌드 및 캐시 산출물 (Build & Cache)
